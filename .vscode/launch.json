{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Tile Creator",
            "type": "debugpy",
            "request": "launch",
            "program": "tile_creator.py",
            "console": "internalConsole"
        },
        {
            "name": "OpenOCD Debug",
            "cwd": "${workspaceRoot}",
            "executable": "./build/Console/GameConsole.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
            ],
            "searchDir": [],
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none",
            "svdFile": "./Drivers/STM32F407.svd",
            "preLaunchCommands": [
                "monitor reset halt"
            ],
            "postLaunchCommands": [
                "add-symbol-file ./build/GameXO/GameXO.elf"
            ],
            "swoConfig": {
                "enabled": true,
                "swoFrequency": 1000000, // ← match your SWO_Init
                "cpuFrequency": 168000000,
                "source": "probe",
                "decoders": [
                    {
                        "type": "console",
                        "label": "SWO",
                        "port": 0
                    }
                ]
            }
        }
    ]
}